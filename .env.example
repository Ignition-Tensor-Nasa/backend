# This template is safe to commit; never put real keys in .env.example.
# Copy it to the git-ignored local file with: cp .env.example .env
# Edit .env with your chosen provider, model and server-side key.
# AI settings are read automatically from .env.
# For other settings, load it before starting: set -a; . ./.env; set +a
# The server and manual search start without AI credentials.

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Natural-language filter assistant (POST /api/v1/filters/interpret).
# live: use the selected provider; never falls back to demo on failure.
# demo: no network; only the rehearsed prompts in app/ai/interpret.py answer.
PSI_AI_MODE=live
# Select anthropic or openrouter; the model must belong to that provider.
PSI_AI_PROVIDER=anthropic
# Example model; replace it if you choose another model or provider.
PSI_AI_MODEL=claude-opus-5-5
# Uncomment in .env and add your Anthropic key when using Anthropic:
# ANTHROPIC_API_KEY=
# For OpenRouter, change PSI_AI_PROVIDER and PSI_AI_MODEL above and add its key.
# Choose an actual model ID that supports JSON schema; avoid duplicate active settings:
# PSI_AI_PROVIDER=openrouter
# PSI_AI_MODEL=provider/model-name
# OPENROUTER_API_KEY=
# Optional OpenRouter reasoning effort (only for models that support it):
# PSI_AI_REASONING_EFFORT=high

# Folder written by the B01 preparation script (python3 -m data_prep.prepare).
# PSI_CURATED_DIR=data/curated
